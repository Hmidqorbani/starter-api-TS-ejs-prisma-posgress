<div class="auth-card">
  <h1>ایجاد حساب کاربری</h1>
  <form action="/register" method="POST" class="form">
    <div class="form-row">
      <div class="form-group">
        <label for="firstName" class="label">نام</label>
        <input type="text" id="firstName" name="firstName" class="input" placeholder="علی" autocomplete="given-name">
      </div>
      <div class="form-group">
        <label for="lastName" class="label">نام خانوادگی</label>
        <input type="text" id="lastName" name="lastName" class="input" placeholder="احمدی" autocomplete="family-name">
      </div>
    </div>
    <div class="form-group">
      <label for="email" class="label">ایمیل</label>
      <input type="email" id="email" name="email" class="input" required autocomplete="email" placeholder="user@example.com">
    </div>
    <div class="form-group">
      <label for="password" class="label">رمز عبور</label>
      <input type="password" id="password" name="password" class="input" required minlength="6" autocomplete="new-password" placeholder="حداقل ۶ کاراکتر">
    </div>
    <button type="submit" class="btn btn-primary btn-block">ثبت‌نام</button>
  </form>
  <p class="auth-footer">
    قبلاً ثبت‌نام کرده‌اید؟ <a href="/login">ورود کنید</a>
  </p>
</div>