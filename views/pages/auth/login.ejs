<div class="auth-card">
  <h1>ورود به حساب</h1>
  <form action="/login" method="POST" class="form">
    <div class="form-group">
      <label for="email" class="label">ایمیل</label>
      <input type="email" id="email" name="email" class="input" required autocomplete="email" placeholder="user@example.com">
    </div>
    <div class="form-group">
      <label for="password" class="label">رمز عبور</label>
      <input type="password" id="password" name="password" class="input" required minlength="6" autocomplete="current-password" placeholder="●●●●●●">
    </div>
    <button type="submit" class="btn btn-primary btn-block">ورود</button>
  </form>
  <p class="auth-footer">
    حساب نداری؟ <a href="/register">ثبت‌نام کن</a>
  </p>
</div>